# ---- again. environment -------------------------------------------------
# Copy to .env.local. Never commit real values.

# mock  = demo adapters everywhere (no keys needed; demo banner shown)
# live  = real adapters as configured below (each provider can still be mock)
APP_MODE=mock
APP_URL=http://localhost:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100
# 32+ random chars; signs session cookies, upload/read URLs and OTP hashes.
APP_SECRET=change-me-to-a-long-random-string

# ---- database (Postgres; local Homebrew/Supabase/any) ----------------------
DATABASE_URL=postgres://localhost:5432/again_dev
DATABASE_TEST_URL=postgres://localhost:5432/again_test

# ---- auth: local (email code shown in demo inbox / SMTP) or supabase --------
AUTH_DRIVER=local
# console = codes shown in the demo banner and /dev/inbox (dev only)
# smtp    = real email through any SMTP provider. Examples:
#   Resend:   smtp://resend:re_YOUR_API_KEY@smtp.resend.com:465          (verify your sending domain in Resend first)
#   Postmark: smtp://TOKEN:TOKEN@smtp.postmarkapp.com:587
#   Gmail:    smtp://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:587       (2-step verification + an App Password; fine for testing only)
MAIL_DRIVER=console            # console | smtp
SMTP_URL=
# Must be an address/domain your provider allows you to send from.
MAIL_FROM="again. <no-reply@yourdomain.com>"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma list of configured OAuth providers (only these buttons render): google,apple
OAUTH_PROVIDERS=

# ---- media storage: local (.data/media) or supabase ------------------------
STORAGE_DRIVER=local
LOCAL_MEDIA_DIR=.data/media
# Public HTTPS base that can reach this app's /media route (needed only when a
# live video provider must fetch the source by URL, e.g. Higgsfield).
PUBLIC_MEDIA_BASE_URL=

# ---- generation ------------------------------------------------------------
GENERATION_ENABLED=true
# Planner: mock | astra
PLANNER_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Renderer: mock | higgsfield | sora
VIDEO_PROVIDER=mock
HF_CREDENTIALS=                # KEY_ID:KEY_SECRET
HF_MODEL=kling-video/v3.0/pro/image-to-video
SORA_MODEL=sora-2
# Planner speed/quality: low ≈13s, medium ≈20s per plan on gpt-6-astra (quality looked equal on samples)
ASTRA_REASONING_EFFORT=low
ASTRA_IMAGE_DETAIL=high
# Plan speculatively when a draft is ready on the Direction screen (one planner call per photo+feeling+direction, ~1-2¢)
PREPLAN_ON_DIRECTION=true
# Deliver at least this long edge (Kling native is ~1744-1764px; 2560 = 2K via lanczos upscale, ~40s extra per film). 0 = native.
OUTPUT_MIN_LONG_EDGE=2560
QUALITY_REVIEW_ENABLED=false
QUALITY_RETRY_LIMIT=0
MAX_ACTIVE_JOBS_PER_USER=2
GLOBAL_GENERATION_CONCURRENCY=4
DAILY_PROVIDER_BUDGET_USD=25
MAX_JOB_PROVIDER_COST_USD=5
PROVIDER_INPUT_URL_TTL_SECONDS=7200
PROVIDER_MEDIA_ALLOWED_HOSTS=
MOCK_GENERATION_SECONDS=20
UNKNOWN_SUBMISSION_SLA_HOURS=24

# ---- payments: mock | stripe ------------------------------------------------
PAYMENTS_ENABLED=true
PAYMENTS_PROVIDER=mock
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PACK_1=
STRIPE_PRICE_PACK_5=
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_MONTHLY_10=
STRIPE_PRICE_CREATOR_25=
STRIPE_API_VERSION=

# ---- demo conveniences (ignored unless APP_MODE=mock or NODE_ENV!=production)
# Credits granted once to each NEW account in mock mode (labeled "Test credits").
DEV_SEED_CREDITS=10
# /review/[01-21] and /dev/* routes are only served when this is true.
REVIEW_ROUTES_ENABLED=true

SUPPORT_EMAIL=support@localhost
